<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- <AssemblyName>idflint</AssemblyName> -->
    <Company>Mitchell T. Paulus</Company>
    <Product>idflint</Product>
      <!-- <RuntimeIdentifiers> -->
          <!-- win-x64;linux-x64;osx-x64 -->
      <!-- </RuntimeIdentifiers> -->
      <LangVersion>default</LangVersion>
      <AssemblyName>idflint</AssemblyName>
      <!-- Only ordinal comparisons and invariant parsing are used, so skipping ICU
           is safe and saves ~3.5ms of startup (measured with Native AOT). -->
      <InvariantGlobalization>true</InvariantGlobalization>
      <!-- Publish with -p:PublishAot=true (see build.sh): ~9ms cold start vs ~170ms
           for the self-contained JIT build. AOT must be published on the target OS. -->
      <StripSymbols>true</StripSymbols>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
