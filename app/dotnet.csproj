    <!--<Compile Include="antlr/idf/IdfListener.cs" />-->
    <!--<Compile Include="antlr/idf/IdfParser.cs" />-->
    <!--<Compile Include="antlr/idf/IdfLexer.cs" />-->
  </ItemGroup>

  <ItemGroup>
    <!-- <None Remove="antlr\idd" /> -->
    <!-- <None Remove="antlr\idf" /> -->
  </ItemGroup>

</Project>
