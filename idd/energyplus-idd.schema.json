{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idflint.dev/schemas/energyplus-idd.schema.json",
  "title": "EnergyPlus IDD JSON Representation",
  "description": "First draft schema describing the normalized JSON representation of an EnergyPlus Input Data Dictionary (IDD) generated by idflint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iddVersion",
    "objects"
  ],
  "properties": {
    "iddVersion": {
      "type": "string",
      "description": "Semantic version string reported by the IDD (e.g., 25.2.0).",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "buildSha": {
      "type": "string",
      "description": "Optional build hash recorded near the top of the IDD.",
      "pattern": "^[0-9a-fA-F]{7,}$"
    },
    "checksum": {
      "type": "string",
      "description": "Digest of the IDD source (e.g., SHA256)."
    },
    "objects": {
      "type": "array",
      "description": "Ordered collection of object definitions. Group membership is maintained as an attribute on each object.",
      "items": {
        "$ref": "#/$defs/objectDefinition"
      }
    }
  },
  "$defs": {
    "objectDefinition": {
      "type": "object",
      "required": [
        "name",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9:-]+$",
          "description": "Object name token at the start of the IDD definition."
        },
        "group": {
          "type": "string",
          "description": "Group label as declared by the preceding \\group statement."
        },
        "displayName": {
          "type": "string",
          "description": "Optional friendly name derived from comments."
        },
        "memo": {
          "type": "array",
          "description": "Object-level \\memo statements.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "description": "Object-level \\note statements.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "format": {
          "type": "string",
          "description": "Value supplied by \\format, if present (e.g., singleLine, vertices, etc.)."
        },
        "minFields": {
          "type": "integer",
          "minimum": 0,
          "description": "Value reported by \\min-fields."
        },
        "requiredObject": {
          "type": "boolean",
          "description": "True when \\required-object appears."
        },
        "uniqueObject": {
          "type": "boolean",
          "description": "True when \\unique-object appears."
        },
        "obsolete": {
          "type": "string",
          "description": "Reason or flag captured from \\obsolete."
        },
        "extensibility": {
          "type": "object",
          "description": "Describes the \\extensible declaration for this object.",
          "additionalProperties": false,
          "properties": {
            "increment": {
              "type": "integer",
              "minimum": 1,
              "description": "Field-count increment reported by \\extensible."
            },
            "description": {
              "type": "string",
              "description": "Text that accompanies the \\extensible statement."
            },
            "firstFieldId": {
              "type": "string",
              "pattern": "^[AN][1-9][0-9]*$",
              "description": "Field identifier where \\begin-extensible appears."
            }
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldDefinition"
          },
          "description": "Ordered collection of data fields defined by the IDD object."
        }
      }
    },
    "fieldDefinition": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[AN][1-9][0-9]*$",
          "description": "Field identifier (e.g., A1, N2)."
        },
        "label": {
          "type": "string",
          "description": "Value provided by the \\field annotation."
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "description": "Ordinal position derived from the field identifier."
        },
        "dataType": {
          "type": "string",
          "enum": [
            "integer",
            "real",
            "alpha",
            "choice",
            "object-list",
            "external-list",
            "node"
          ],
          "description": "Value taken from the \\type statement."
        },
        "units": {
          "type": "string",
          "description": "Units declared by \\units."
        },
        "ipUnits": {
          "type": "string",
          "description": "Units declared by \\ip-units."
        },
        "unitsBasedOnField": {
          "type": "string",
          "pattern": "^[AN][1-9][0-9]*$",
          "description": "Field reference mentioned by \\unitsBasedOnField."
        },
        "minimum": {
          "type": "number",
          "description": "Inclusive minimum specified with \\minimum."
        },
        "exclusiveMinimum": {
          "type": "number",
          "description": "Exclusive minimum specified with \\minimum>."
        },
        "maximum": {
          "type": "number",
          "description": "Inclusive maximum specified with \\maximum."
        },
        "exclusiveMaximum": {
          "type": "number",
          "description": "Exclusive maximum specified with \\maximum<."
        },
        "default": {
          "description": "Default value supplied by \\default.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "required": {
          "type": "boolean",
          "description": "True when \\required-field appears."
        },
        "deprecated": {
          "type": "boolean",
          "description": "True when \\deprecated appears."
        },
        "autosizable": {
          "type": "boolean",
          "description": "True when \\autosizable appears."
        },
        "autocalculatable": {
          "type": "boolean",
          "description": "True when \\autocalculatable appears."
        },
        "retaincase": {
          "type": "boolean",
          "description": "True when \\retaincase appears."
        },
        "keys": {
          "type": "array",
          "description": "Ordered list of \\key values.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "objectLists": {
          "type": "array",
          "description": "List names supplied via \\object-list.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "externalList": {
          "type": "string",
          "description": "Identifier supplied via \\external-list."
        },
        "references": {
          "type": "array",
          "description": "Targets named by \\reference.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "referenceClassName": {
          "type": "string",
          "description": "Class provided by \\reference-class-name."
        },
        "notes": {
          "type": "array",
          "description": "Field-level \\note statements.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "memo": {
          "type": "array",
          "description": "Field-level \\memo statements.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "beginExtensible": {
          "type": "boolean",
          "description": "True when \\begin-extensible is attached to this field."
        }
      }
    }
  }
}
